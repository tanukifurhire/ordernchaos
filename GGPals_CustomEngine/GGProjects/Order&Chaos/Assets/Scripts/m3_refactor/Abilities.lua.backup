            end

            if tile2 then
                if grid.Tiles[tile2].occupied then
                    damageVal = damageVal + ability.unitDamage
                else
                    grid.Tiles[tile2].health = math.max(0, math.min(5, grid.Tiles[tile2].health - ability.tileDamage))
                end
            end

            if tile3 then
                if grid.Tiles[tile3].occupied then
                    damageVal = damageVal + ability.unitDamage
                else
