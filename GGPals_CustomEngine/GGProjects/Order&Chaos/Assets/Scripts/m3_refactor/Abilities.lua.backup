            Log.info("ORACLE_2 Selected!")

            local session = SessionManager_instance.sessionID
            local grid = GridInstances[session].OrderGrid

            local numRed, numBlue = CountNumTiles(grid)

            local ability = AbilityList[2]

            if (numRed >= ability.numRed) 
            and (numBlue >= ability.numBlue) then
                self.orderAP = self.orderAP - CONSTANTS.TEMP_ABILITY_COST
                Event.emitLocal("OnAPUpdate", {
                    value = self.orderAP
                })
                Event.emitLocal("PlayUIAbilityValid", {})
                ability.Trigger(self, entity, ability)
                return false
            end
            return false
        end,
        Update = function(self, entity)
            
        end,
        Queue = function(self, entity)
            
        end
    },

    -- DRAGOON_1
    [3] = {
        -- UNIT.DRAGOON
        unit = 1,
        numBlue = 0,
        numRed = 2,
        targetGridX = 0,
        targetGridY = 0,
        unitDamage = 2,
        tileDamage = 2,
        Trigger = function(self, entity, ability)
            Log.info("DRAGOON_1 Trigger!")

